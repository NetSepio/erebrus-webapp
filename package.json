{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "predev": "node scripts/sync-brand-assets.mjs && node scripts/sync-install-sh.mjs",
    "prebuild": "node scripts/sync-install-sh.mjs",
    "sync:install": "node scripts/sync-install-sh.mjs",
    "dev": "next dev",
    "dev:stop": "node -e \"const fs=require('fs');const p='.next/dev/lock';try{const l=JSON.parse(fs.readFileSync(p,'utf8'));process.kill(l.pid,9)}catch(e){}try{fs.unlinkSync(p)}catch(e){}\" && (lsof -ti :3000 | xargs kill -9 2>/dev/null || true)",
    "dev:fresh": "pnpm dev:stop && pnpm dev",
    "sync:brand": "node scripts/sync-brand-assets.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next node_modules"
  },
