# Copy to .env or .env.local for local development:
#   cp .env.example .env.local
#
# Only these three variables are required. See src/lib/env.ts.

# Reown AppKit project ID — https://dashboard.reown.com
NEXT_PUBLIC_PROJECT_ID=

# Erebrus API gateway base URL (production default shown)
NEXT_PUBLIC_GATEWAY_URL=https://gateway.erebrus.io

# Helius API key — Solana NFT metadata (profile & subscribe pages)
# https://dashboard.helius.dev
NEXT_PUBLIC_HELIUS_API_KEY=

# Optional social login (both sides must be configured):
# 1) Set NEXT_PUBLIC_GOOGLE_CLIENT_ID to your Google OAuth Web client ID
# 2) Add the same ID to gateway GOOGLE_CLIENT_IDS (comma-separated if multiple)
# 3) In Google Cloud Console → Credentials → Authorized JavaScript origins,
#    add http://localhost:3000 and your production webapp origin
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# IPFS for profile images (defaults target a local Kubo daemon).
# IPFS_API_URL — node HTTP API the upload route posts to (server-side only)
# NEXT_PUBLIC_IPFS_GATEWAY_URL — public gateway base used to render images;
# switch to a hosted gateway before production.
IPFS_API_URL=http://127.0.0.1:5001
NEXT_PUBLIC_IPFS_GATEWAY_URL=http://127.0.0.1:8080/ipfs/